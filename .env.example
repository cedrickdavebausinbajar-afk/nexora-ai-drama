# Copy to .env.local. These are public Firebase web-app values, not server credentials.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# NEXORA ADMIN Firebase project (nexora-admin-6313f)
VITE_NEXORA_FIREBASE_API_KEY=
VITE_NEXORA_FIREBASE_AUTH_DOMAIN=nexora-admin-6313f.firebaseapp.com
VITE_NEXORA_FIREBASE_PROJECT_ID=nexora-admin-6313f
VITE_NEXORA_FIREBASE_APP_ID=
VITE_NEXORA_APPCHECK_RECAPTCHA_SITE_KEY=
VITE_APP_VERSION=1.0.195

# Public PayMongo key for browser-side card tokenization (never use a secret key here).
VITE_PAYMONGO_PUBLIC_KEY=pk_test_REPLACE_WITH_PUBLIC_KEY
# HTTPS URL used after card/3DS authentication. Required for native Android builds.
VITE_NEXORA_PAYMENT_RETURN_URL=https://YOUR-NEXORA-APP-DOMAIN.example/
